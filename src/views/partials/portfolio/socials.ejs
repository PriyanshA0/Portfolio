<section class="social-section" id="contact">
  <div class="section-title reveal">
    <h2>Social Links</h2>
    <p>Drop a message, follow the work, or hire me for your next idea.</p>
  </div>
  <div class="social-grid">
    <% socials.forEach((social) => { %>
      <a class="social-card reveal" href="<%= social.url %>" target="_blank" rel="noreferrer">
        <span class="social-icon"><%= social.icon %></span>
        <span><%= social.name %></span>
      </a>
    <% }) %>
  </div>
  <div id="github-activity-container" class="section-title" style="max-width:920px;margin:2rem auto 0;">
    <div id="github-activity" class="paper-card reveal" style="padding:1rem;">Loading GitHub activity…</div>
  </div>
</section>
