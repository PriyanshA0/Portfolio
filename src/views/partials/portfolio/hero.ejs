<header class="hero" id="top">
  <div class="hero-grid">
    <div class="hero-copy reveal">
      <span class="eyebrow">Hey! I am</span>
      <h1><%= profile.name %></h1>
      <p class="hero-tagline"><%= profile.headline %></p>
      <div class="hero-actions">
        <a href="#projects" class="btn primary">View Projects</a>
        <a href="#contact" class="btn ghost">Get in Touch</a>
      </div>
      <div class="hero-chips">
        <span><%= profile.location %></span>
        <% profile.chips.forEach(function(chip){ %>
          <span><%= chip %></span>
        <% }) %>
      </div>
    </div>
    <div class="hero-photo reveal">
      <div class="photo-frame">
        <img src="<%= profile.avatar %>" alt="<%= profile.name %>" onerror="this.src='/img/profile-placeholder.svg'">
        <div class="photo-badge"><%= profile.role %></div>
      </div>
      <div class="hero-stickers">
        <% (profile.stickers || ['Creative','Curious','Builder']).forEach(function(s){ %>
          <div class="sticker"><%= s %></div>
        <% }) %>
      </div>
    </div>
  </div>
</header>
