<section class="collage-section">
  <div class="section-title reveal">
    <h2>Story in scraps</h2>
    <p>A quick snapshot of my background, education, and what fuels my work.</p>
  </div>
  <div class="collage-grid">
    <article class="paper-card reveal">
      <h3>About Me</h3>
      <% if (profile && profile.about) { %>
        <% profile.about.forEach(function(p){ %>
          <p><%= p %></p>
        <% }) %>
      <% } else { %>
        <p>Brief info about you goes here. Replace these placeholder lines with your bio.</p>
      <% } %>
    </article>
    <article class="paper-card reveal">
      <h3>Education</h3>
      <% if (profile && profile.education) { %>
        <% profile.education.forEach(function(edu){ %>
          <p><strong><%= edu.school %></strong> — <%= edu.degree %> <span class="muted">(<%= edu.years %>)</span></p>
        <% }) %>
      <% } else { %>
        <p>Your educational background goes here.</p>
      <% } %>
    </article>
    <article class="paper-card reveal">
      <h3>Interests</h3>
      <% if (profile && profile.interests) { %>
        <ul>
          <% profile.interests.forEach(function(i){ %>
            <li><%= i %></li>
          <% }) %>
        </ul>
      <% } else { %>
        <ul>
          <li>Interest one</li>
          <li>Interest two</li>
        </ul>
      <% } %>
    </article>
  </div>
</section>
